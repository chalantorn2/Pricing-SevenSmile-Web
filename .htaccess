# .htaccess for React Router + PHP API
RewriteEngine On

# Handle PHP API requests first
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/$1 [L]

# Handle React Router (SPA) - redirect all non-file requests to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^(.*)$ index.html [L]

# Optional: Prevent access to sensitive files
<Files "*.env">
    Order allow,deny
    Deny from all
</Files>

<Files "*.sql">
    Order allow,deny
    Deny from all
</Files>

# Enable CORS for API
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    # Must include every custom header the app sends: X-Auth-Token (login session,
    # see api/_auth.php) and X-API-Key (public API, see api/public/_config.php).
    # This "set" replaces whatever PHP sent, so keep the list in sync with
    # api/config.php and api/public/_config.php.
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Auth-Token, X-API-Key"
</IfModule>